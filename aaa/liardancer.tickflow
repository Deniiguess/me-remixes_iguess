#include beat/beatanims.tickflow
#include docs-tickflow/lumbearjack.tickflow
#include docs-tickflow/karateMan.tickflow
#include docs-tickflow/builtToScale.tickflow

#index 0x33

prologueId=0x5F
epilogueId=0x33

tempoId=0x100000D

BASE_LYRIC_HEIGHT = 0x68

gameplay:

call changeEngine
engine 0x25
sub 4
0x29<2> 
call tempoAndMusic
async_call INTRO
rest 0x30 * 60
0x78 1, 0x77, 0x56, 0xB0 // sets color
0x79 1, 40 // sets layer
0x77 1, 0xFF // sets transparency
rest 0xE0

// haha take that flicker!!
