rest 0xC0
0x103<5> "joe_peace_black_cred3", 0
rest 0xC0
0x103<5> "joe_peace_black_cred4", 0
rest 0x90
rest 0xC
zoom 3, 0x100, 0x100
0x103<5> "joe_transition", 1
stop

