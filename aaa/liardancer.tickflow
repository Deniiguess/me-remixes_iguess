0x29<1> 1
0x8B 0, 0
0x101<1> 2
pan 3, 0, 0
zoom 3, 0x100, 0x100
0x103<5> "joe_tired", 8
goto 0x3e71
label 0x641
0xB5 0x511574

0x76 1, 0 // disables
0x29<2>
rest 9
async_call OUTRO
rest 0x30*46

0x7C 7, 1, 0x28
rest 0x30 * 4
play_sfx 0x100029F
0x8C 1
call unload
0x2D 0
sub 0xB
stop 

INTRO:
	0x8B 0, 0
	0x101<1> 2
	pan 3, -250, 0
	fade<1> 7, 0, 1
rest 0x30
0x103<5> "joe_idle", 8
pan_gradual 3, 1, 1, 0x30*30, -10, 0
rest 0x30*30
0x103<5> "joe_idle_no", 1
rest 0x30
rest 0x24
rest 4
0x103<5> "joe_peace", 1
rest 8
async_call textbeat
zoom_gradual 3, 1, 1, 0x30*31+0x18, 0x118, 0x118
rest 0xC0*3
rest 0x90
rest 0x18
kill_loc textbeat
rest 0x18
0x104<4> "monkey_beat", 0
0x103<5> "joe_peace_black_cred1", 0
rest 0xC0
